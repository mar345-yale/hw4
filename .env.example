# Copy this file to ".env" (in this same repo-root folder) and fill in your own values.
# Never commit your real .env — it is git-ignored.

# Your Portkey API key (used to reach the OpenAI-compatible model through Portkey).
PORTKEY_API_KEY=your-portkey-api-key-here

# Model and endpoint (defaults shown; override only if you need to).
OPENAI_MODEL=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: set a stable secret so login sessions survive a backend restart.
# AUTH_SECRET=change-me-to-a-long-random-string
